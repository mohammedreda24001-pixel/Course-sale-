# Supabase (server)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Signed application session cookie (use a long random value in production)
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS

# Al-Waseet merchant API (server only; never prefix with NEXT_PUBLIC_)
WASEET_API_BASE_URL=https://api.alwaseet-iq.net/v1/merchant
WASEET_USERNAME=YOUR_MERCHANT_USERNAME
WASEET_PASSWORD=YOUR_MERCHANT_PASSWORD
WASEET_TOKEN_TTL_SECONDS=1200
WASEET_REQUEST_TIMEOUT_MS=20000
# V2.3 limit: 30 requests / 30 seconds. Reservations are coordinated in Supabase.
WASEET_MIN_REQUEST_INTERVAL_MS=1050

# Optional endpoint protection for scheduled sync jobs
CRON_SECRET=CHANGE_ME
